{
  "name": "dsh-plugin-muelsyse-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Muelsyse · 生态科 — left-sidebar console for the DSH theme: four openings, three sound beds, runtime status.",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
